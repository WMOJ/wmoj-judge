// wmoj-judge unified seccomp policy (Kafel) -- amd64 (Render target)
//
// Covers Python 3, PyPy 3, and compiled C++ binaries -- one policy for
// all six language IDs (python3, pypy3, cpp14/17/20/23). Java was
// removed from the judge; the JVM notes further down are historical.
//
// Strategy: permissive DEFAULT with explicit denylist.
//   - DEFAULT is ERRNO(38) (ENOSYS), not KILL -- see the USE line at the
//     bottom of this file for why ENOSYS specifically. Unknown syscalls
//     return -1 to user code instead of SIGSYS-killing the whole
//     process. This is the posture Docker, systemd (SystemCallFilter),
//     and Kubernetes (RuntimeDefault) all use.
//   - An explicit DENY block (ERRNO(1), EPERM) documents the syscalls we
//     never want to succeed, and gives applications the errno they
//     expect on them. It is belt-and-suspenders to the DEFAULT and makes
//     the security contract legible in the file itself.
//   - The ALLOW block is the fast-path: syscalls the runtimes are known
//     to call on every run. Kept so that common paths never pay the
//     filter-evaluation cost of falling through to DEFAULT.
//
// Why not DEFAULT KILL with a big ALLOW list? Because modern glibc
// probes rseq, statx, faccessat2, close_range, clone3, openat2 -- none
// of which Kafel 3.3 knows about in its amd64 syscall table. Under
// DEFAULT KILL, every probe SIGSYS-kills the process before main() runs
// (exit 159 = 128+31). Under DEFAULT ERRNO, glibc gets an errno back,
// transparently falls back to the classic syscall (newfstat, faccessat,
// close, fork, openat), and execution continues.
//
// References: google/kafel syscall_amd64.c, Judge0/isolate, DMOJ's
// executor/cptbox, nsjail examples.

POLICY wmoj_judge {
  // ---- Explicit DENY: dangerous syscalls -------------------------------
  // Each returns EPERM. Documents the denylist even though DEFAULT ERRNO
  // also catches anything not listed elsewhere. Names not in Kafel 3.3's
  // amd64 table (umount2, clone3, statx, close_range, the io_uring
  // family, pidfd_*, pkey_*, mount_setattr, fs*-era mount v2, mq_close/
  // send/receive, posix_fadvise, rt_sigtimedwait_time64, the *_time64
  // compat wrappers) are still blocked by DEFAULT ERRNO; we list only
  // names Kafel accepts so the policy compiles cleanly.
  ERRNO(1) {
    // Network (the judge has no business touching sockets).
    socket, socketpair, connect, bind, listen, accept, accept4,
    sendto, recvfrom, sendmsg, recvmsg, sendmmsg, shutdown,
    getsockname, getpeername, getsockopt, setsockopt,

    // Debug / cross-process inspection.
    ptrace, process_vm_readv, process_vm_writev, kcmp,

    // Filesystem / namespace mutation.
    mount, umount, pivot_root, chroot, swapon, swapoff,

    // Kernel module / reboot / kexec / bpf.
    init_module, finit_module, delete_module,
    kexec_load, kexec_file_load, reboot, bpf,

    // Namespace escape.
    unshare, setns,

    // Privileged id changes (the pool UID must stay the pool UID).
    setuid, setgid, setreuid, setregid, setresuid, setresgid,
    setfsuid, setfsgid, setgroups, capset, personality,

    // Key / keyring, tracing, quota, accounting, wall clock, IO ports.
    add_key, request_key, keyctl,
    perf_event_open, quotactl, acct,
    settimeofday, clock_settime, clock_adjtime, adjtimex,
    vhangup, ioperm, iopl
  },

  // ---- Fast-path ALLOW: the hot set the runtimes actually use ----------
  ALLOW {
    // ---- Process lifecycle ----
    // execve / execveat: nsjail's subproc::newProc installs the
    // seccomp filter via sandbox::applyPolicy (subproc.cc:209) and then
    // calls execv() (line 222) -- or execveat(), if --execute_fd is set --
    // to transition into the user binary (e.g. ./a.out, /usr/bin/python3).
    // Because the seccomp filter is live at the moment of exec, both
    // syscalls must be in the allow-list or the kernel SIGSYS-kills the
    // process before a single instruction of user code runs (exit 159).
    execve,
    execveat,
    exit,
    exit_group,
    rt_sigreturn,
    rt_sigaction,
    rt_sigprocmask,
    rt_sigpending,
    rt_sigsuspend,
    rt_sigqueueinfo,
    rt_sigtimedwait,
    rt_tgsigqueueinfo,
    sigaltstack,
    tgkill,
    tkill,
    kill,
    getpid,
    gettid,
    getppid,
    getuid,
    geteuid,
    getgid,
    getegid,
    getpgid,
    getsid,
    getresuid,
    getresgid,
    set_tid_address,
    set_robust_list,
    get_robust_list,
    prctl,
    arch_prctl,
    capget,
    sched_yield,
    sched_getaffinity,

    // sched_setaffinity takes a pid, and a non-zero pid means "some
    // other process". --user/--group are absent, so every submission
    // runs as UID 1000 -- the same UID as the Node judge -- and there
    // is no PID namespace, so a submission can walk /proc and name any
    // of them. TLE here is decided from CPU time, which affinity does
    // not change, but the wall backstops are not immune: pin a
    // concurrently running submission onto one contended core and it
    // can cross nsjail's --time_limit or the 3x-wall rule, so another
    // student's correct solution comes back TLE with nothing in the
    // logs to explain it. pid == 0 ("myself") is the only form a
    // submission has any business using; a non-zero pid matches no rule
    // and falls through to DEFAULT ERRNO(38). sched_getaffinity above
    // stays unfiltered on purpose -- it only reads a CPU mask, and
    // glibc's get_nprocs() and CPython's os.cpu_count() go through it.
    sched_setaffinity { pid == 0 },

    sched_getparam,
    sched_getscheduler,
    sched_get_priority_max,
    sched_get_priority_min,

    // clone is allowed only with no CLONE_NEW* flags. Mask covers all
    // CLONE_NEWNS/UTS/IPC/USER/PID/NET/CGROUP bits (0x7E020000).
    // clone3 is unknown to this Kafel -- falls through to DEFAULT ERRNO.
    // glibc tries clone3 first then falls back to clone on ENOSYS/EPERM.
    clone { (clone_flags & 0x7E020000) == 0 },

    wait4,
    waitid,
    pause,
    nanosleep,
    clock_nanosleep,
    futex,
    membarrier,

    // ---- Time ----
    clock_gettime,
    clock_getres,
    gettimeofday,
    time,
    times,

    // ---- Memory ----
    brk,
    mmap,
    mremap,
    munmap,
    mprotect,
    madvise,
    mlock,
    munlock,
    mlockall,
    munlockall,
    msync,

    // ---- File I/O ----
    read,
    pread64,
    readv,
    preadv,
    preadv2,
    write,
    pwrite64,
    writev,
    pwritev,
    pwritev2,
    open,
    openat,
    close,
    // On amd64 Kafel calls these newstat / newfstat / newlstat / newuname.
    newstat,
    newfstat,
    newlstat,
    newfstatat,
    access,
    faccessat,
    lseek,
    fsync,
    fdatasync,
    sync_file_range,
    readahead,
    pipe,
    pipe2,
    dup,
    dup2,
    dup3,
    fcntl,
    flock,
    truncate,
    ftruncate,
    getdents,
    getdents64,
    getcwd,
    chdir,
    fchdir,
    readlink,
    readlinkat,
    unlink,
    unlinkat,
    rename,
    renameat,
    renameat2,
    mkdir,
    mkdirat,
    rmdir,
    chmod,
    fchmod,
    fchmodat,
    chown,
    fchown,
    fchownat,
    lchown,
    umask,

    // ioctl was previously cmd-filtered. It is unfiltered now so the
    // runtimes' terminal probes never come back with an error they did
    // not expect: CPython and PyPy both isatty() stdin/stdout/stderr
    // while building sys.std*, which is an ioctl(TCGETS) per fd on
    // every single run.
    //
    // The justification that used to sit here was wrong, and it cited
    // the JVM this judge no longer runs. It claimed dangerous commands
    // (TIOCSTI etc.) have no target "because the only open fds point to
    // the jailed workdir, pipes, and /dev/null from nsjail". They do
    // not: there is no --chroot and no path filter on open/openat, so
    // the child can open anything UID 1000 can reach -- /app, /proc,
    // another submission's workdir (AGENTS.md, "Sandbox").
    //
    // What actually holds is narrower, and it is about fds, not paths.
    // The judge gives the child pipes for fds 0/1/2, spawns the runner
    // detached so setsid() has already dropped any controlling
    // terminal, and setsid/setpgid are absent from this ALLOW block, so
    // the child cannot become a session leader and acquire one: /dev/tty
    // is ENXIO, and a TIOCSTI has nowhere to land except a pty the child
    // opened for itself. The container's /dev carries no block device,
    // no /dev/net/tun and no /dev/kvm. If a real tty, a new device node,
    // or setsid ever reaches the child, this needs a cmd filter again.
    ioctl,

    // ---- Process info / resource reporting ----
    getrusage,
    getrlimit,

    // prlimit64 is filtered to pid == 0 ("myself"). The self form has
    // to stay: glibc 2.34+ implements getrlimit/setrlimit on top of
    // prlimit64 with pid 0, and reads RLIMIT_STACK through it before
    // main() runs, so denying it stops every runtime before it starts.
    //
    // The foreign-pid form has to go. The kernel lets one process LOWER
    // another's limits on a full UID match without CAP_SYS_RESOURCE;
    // --user/--group are absent so every submission shares UID 1000
    // with the Node judge, and there is no PID namespace, so /proc
    // hands out the targets. prlimit64(victim, RLIMIT_CPU, {1,1}) --
    // below the CPU that victim has already burned -- delivers SIGXCPU
    // at once, so another student's correct solution comes back RE with
    // nothing in the logs; prlimit64(node_pid, RLIMIT_NOFILE, {0,0})
    // leaves a judge that still answers /health "ok" while every
    // workdir write, compile-cache write and socket accept fails.
    // Whether the foreign path actually reaches its victim also depends
    // on the host's kernel.yama.ptrace_scope (the victim is a sibling,
    // not a descendant, so scope 1 already blocks it) -- we do not set
    // it and Render does not tell us, which is exactly why this is
    // filtered rather than argued about.
    //
    // pid is a 4-byte argument, so Kafel compares only the low 32 bits
    // of the register -- the same bits the kernel truncates to pid_t,
    // so there is no high-half bypass in either direction. A non-zero
    // pid matches no rule and falls through to DEFAULT ERRNO(38).
    prlimit64 { pid == 0 },

    // setrlimit is deliberately NOT filtered: it has no pid argument
    // and only ever acts on the caller, and nsjail sets every --rlimit_*
    // with rlim_cur == rlim_max, so raising one back up needs
    // CAP_SYS_RESOURCE the child does not have. glibc and CPython's
    // resource module both reach it.
    setrlimit,

    sysinfo,
    newuname,

    // ---- Randomness ----
    getrandom,

    // ---- Polling / event loops (JVM, PyPy, glibc) ----
    poll,
    ppoll,
    select,
    pselect6,
    epoll_create,
    epoll_create1,
    epoll_wait,
    epoll_pwait,
    epoll_ctl,
    eventfd,
    eventfd2,
    timerfd_create,
    timerfd_gettime,
    timerfd_settime,

    // ---- Shared memory: memfd_create is deliberately absent ----
    // It was here for one reason -- the JVM's class-data-sharing
    // archive -- and Java was removed from the judge, so the reason went
    // with it. python3, pypy3 and a g++ binary do not need it, and it
    // was the one allowed way to hold RAM the judge cannot see: a memfd
    // is shmem-backed, so its pages are charged to neither --rlimit_as
    // nor maxrss, which means neither RSS-based MLE rule can see them.
    // --rlimit_fsize caps one memfd at 10 MB and --rlimit_nofile allows
    // 256 of them, so ~2.5 GB of resident RAM on a 512 MB host, with no
    // MLE and no verdict -- just an OOM kill of the container.
    // /dev/shm is bounded by Docker's 64 MB default; memfd is not.
    //
    // Absent, it falls through to DEFAULT ERRNO(38). ENOSYS is exactly
    // what a pre-3.17 kernel returns, so every caller that has a
    // fallback takes it. Do not re-add it without a runtime that needs
    // it (AGENTS.md: never widen the allowlist to make something work).

    // ---- Extended attributes ----
    getxattr,
    lgetxattr,
    fgetxattr,
    listxattr,
    llistxattr,
    flistxattr,

    // ---- Restart interrupted syscalls (glibc) ----
    restart_syscall
  }
}

// DEFAULT = ENOSYS (errno 38), NOT EPERM. Critical for glibc thread
// creation: modern glibc (2.34+, which Debian trixie has at 2.37+)
// calls clone3() first for pthread_create and only falls back to the
// classic clone() when clone3 returns ENOSYS. Under the previous
// DEFAULT ERRNO(1), clone3 returned EPERM and glibc propagated that
// straight to pthread_create, producing the JVM error:
//     "pthread_create failed (EPERM) for attributes: stacksize: 1024k"
//     "Cannot create VM thread. Out of system resources."
// The explicit ERRNO(1) denylist block above still returns EPERM for
// the dangerous syscalls that applications EXPECT to see EPERM on
// (socket/connect/ptrace/mount/etc). Only *unlisted* syscalls fall
// through to this default -- precisely the ones where ENOSYS is the
// right "not supported, try an older syscall" semantic. Security is
// unchanged: blocked is blocked, just a different errno.
USE wmoj_judge DEFAULT ERRNO(38)

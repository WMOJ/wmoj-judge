{
  "name": "truncated-stdout",
  "endpoint": "/submit",
  "request": {
    "language": "cpp17",
    "code": "// Writes 2 MiB, twice the sandbox's 1 MiB stdout cap, so the retained\n// stdout is a prefix and `truncated` is set.\n#include <cstdio>\n\nint main() {\n  for (int i = 0; i < 2 * 1024 * 1024; ++i) std::putchar('x');\n  return 0;\n}\n",
    "input": [
      "1\n"
    ],
    "output": [
      "x\n"
    ]
  },
  "requires": [],

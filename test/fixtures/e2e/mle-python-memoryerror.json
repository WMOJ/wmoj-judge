{
  "name": "mle-python-memoryerror",
  "endpoint": "/submit",
  "request": {
    "language": "python3",
    "code": "# The CPython twin of refuse-allocation.cpp: 600 MB under a 256 MB cap\n# raises MemoryError, which is the other signature the allocation-signature\n# MLE rule recognises.\nb = bytearray(600 << 20)\nprint(len(b))\n",
    "input": [
      "1\n"
    ],
    "output": [
      "1\n"
    ],
    "timeLimit": 2000,
    "memoryLimit": 256
  },
  "requires": [
    "rlimit_as"
  ],
  "status": 200,
  "response": {
    "summary": {
      "total": 1,
      "passed": 0,
      "failed": 1
    },
    "results": [
      {
        "index": 0,
        "exitCode": 1,
        "passed": false,
        "expected": "1\n",
        "received": "",
        "stdout": "",
        "timedOut": false,
        "verdict": "MLE"
      }
    ],
    "effectiveMemoryLimitMb": 256
  },
  "patterns": {
    "results[0].stderr": "MemoryError"
  },
  "measured": {
    "results": [
      {
        "cpuMs": ">0",
        "memKb": ">0",
        "timeMs": ">0"
      }
    ]
  }
}

        "index": 0,
        "exitCode": null,
        "passed": false,
        "expected": "3\n",
        "received": "",
        "stderr": "",
        "stdout": "",
        "timedOut": true,
        "verdict": "TLE"
      }
    ],
    "effectiveMemoryLimitMb": 256
  },
  "patterns": {},

{
  "name": "judge",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "LOG_LEVEL=silent node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"test/e2e/**/*.test.ts\"",
    "capture:e2e": "tsx test/e2e/capture.ts",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "nanoid": "^3.3.7",
    "p-limit": "^3.1.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}

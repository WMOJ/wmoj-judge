# wmoj-judge environment variables
#
# NOTE: this service does NOT load a .env file. There is no `dotenv` and no `--env-file`; that is
# deliberate. This file documents what the process reads from its real environment. Locally, pass
# them with `docker run -e ...`; in production they come from the Render dashboard.
#
# Only JUDGE_SHARED_SECRET is required in production. Everything else has a working default, and the
# two path variables are already baked into the image.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Shared secret. Must be byte-identical to JUDGE_SHARED_SECRET in wmoj-app.
# NODE_ENV=production is baked into the image, so a missing value exits 1 at boot.
# Compared in constant time; the process deletes it from process.env after reading it.
JUDGE_SHARED_SECRET=replace-with-a-long-random-string

# Enforce the shared secret. Defaults to true whenever NODE_ENV=production, false otherwise, so a
# local run works without a secret and production cannot silently fail open. In soft mode a *missing*
# token is let through, not just a wrong one. CORS is wide open and this secret is the only gate.
# An unrecognised value (e.g. "on") now refuses to boot rather than quietly meaning false.
AUTH_STRICT=true

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Render injects PORT; JUDGE_PORT is the local override. Default 4001.
# PORT=4001
# JUDGE_PORT=4001

# ---------------------------------------------------------------------------
# Baked into the image — override only if you moved them
# ---------------------------------------------------------------------------

# NSJAIL_BIN=/usr/local/bin/nsjail
# SECCOMP_POLICY=/app/policy.kafel

# Both are required for every submission, and both are now probed at boot and by /health: the judge
# REFUSES TO BOOT if nsjail is missing or the seccomp policy will not compile, rather than starting
# healthy and returning RE for every test case. Running from source outside Docker needs
# SECCOMP_POLICY pointed at the checkout's policy.kafel, or the judge will not start.
#
# The policy is written for the amd64 syscall table. On an arm64 host it fails to compile
# ("Undefined identifier `umount'"), so build and run with --platform=linux/amd64.

# ---------------------------------------------------------------------------
# Optional tuning — all have defaults; leave unset unless you have a reason.
# Every numeric variable below must be a COMPLETE base-10 integer within its bounds; a malformed or
# out-of-range value refuses to boot rather than silently becoming a different number.
# ---------------------------------------------------------------------------

# Ceiling applied to every submission's requested memory limit, in MB. Default 384.
#
# NOT 512, even though the instance has 512 MB: the Node process, its heap and the compile cache all
# live inside that same 512 MB, so a ceiling equal to the box hands one submission the whole machine
# and the container OOM-killer fires before RLIMIT_AS does — killing every in-flight submission
# instead of returning the clean MLE the contract promises. 384 leaves ~128 MB for the judge.
# A problem may declare more; it runs at this cap. Raise it only on a host with more RAM.
# HOST_MEMORY_CEILING_MB=384

# Concurrent /submit slots. Derived: max(1, min(cpuCount, floor(HOST_MEMORY_CEILING_MB / 256))).
# NOT os.cpus().length — inside a container that reads the HOST's /proc/cpuinfo and is blind to the
# CFS quota, so on a ~0.1-vCPU instance it reported 4-16 and sized concurrency off a number with
# nothing to do with this box. Memory is the real constraint. The 16-UID pool is still the true
# ceiling. At the default ceiling this resolves to 2.
# GLOBAL_SUBMIT_CONCURRENCY=2

# Test cases run in parallel within one submission. MUST stay 1 — parallel runs on shared vCPUs
# made TLE non-deterministic.
# PER_SUBMISSION_CONCURRENCY=1

# Concurrency gate for sandboxed runs. Covers both gated endpoints.
# UID_POOL_SIZE=16

# Compile cache. TTL-only, no size cap. The directory must keep the `judge-` prefix — the boot sweep
# removes every os.tmpdir() entry starting with `judge-`, which is what stops it leaking across
# restarts. Moving it off that prefix INTRODUCES a leak.
# COMPILE_CACHE_DIR=<os.tmpdir()>/judge-cache
# COMPILE_CACHE_TTL_MS=900000

# Rate limit across both gated routes. There is no `trust proxy` and one token, so all of wmoj-app
# shares a single bucket.
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# pino level. Default info. Validated against pino's seven levels; anything else refuses to boot.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Set by the platform — do not set by hand
# ---------------------------------------------------------------------------

# RENDER_GIT_COMMIT — injected by Render. Reported by /health as the `version` deployment marker;
# falls back to package version + start time when absent.
